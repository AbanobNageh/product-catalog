# Copy to .env (git-ignored) and replace both secrets. MinIO wants at least
# 8 characters. To generate one in PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object { [char]$_ })

# MinIO's admin account. Used only by the `setup` service and the web console.
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-root

# Terraform's own user, limited to terraform-state/product-catalog/*.
# Put the same two values in the `catalog-state` profile of
# %USERPROFILE%\.aws\credentials (see AGENTS.md).
TF_STATE_ACCESS_KEY=terraform-state
TF_STATE_SECRET_KEY=change-me-terraform
