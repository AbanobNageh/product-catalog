# e2e test environment, used by `npm run test:e2e` (copy to .env.test to override).
# The e2e setup applies migrations here and the tests write to it, so the
# database name must end in _test.
DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog_test
# Redis DB 1, so test keys stay out of the dev DB 0.
REDIS_URL=redis://localhost:6379/1
LOG_LEVEL=warn
# Placeholder so config loads; the e2e test replaces it with its fake
# search-service (1.4 Task 3), so the dev search index is never touched.
SEARCH_SERVICE_URL=http://127.0.0.1:9
# API keys (ADR-0020). Dev only, not secret.
READ_API_KEY=dev-read-key-not-secret-0000000000000000
WRITE_API_KEY=dev-write-key-not-secret-000000000000000
ADMIN_API_KEY=dev-admin-key-not-secret-000000000000000
