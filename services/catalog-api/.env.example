# Copy to .env for local development (`npm run start:dev`).
# Containers get these as real environment variables instead.
PORT=3000
DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog
REDIS_URL=redis://localhost:6379/0
SEARCH_SERVICE_URL=http://localhost:8080
# CATALOG_API_URL=http://localhost:3000   # seed only; this is the default
LOG_LEVEL=debug
# API keys (ADR-0020). Dev only, not secret; they match docker-compose.yml.
READ_API_KEY=dev-read-key-not-secret-0000000000000000
WRITE_API_KEY=dev-write-key-not-secret-000000000000000
ADMIN_API_KEY=dev-admin-key-not-secret-000000000000000
# The seed's key: it calls POST /admin/reindex, so it needs the admin key.
CATALOG_API_KEY=dev-admin-key-not-secret-000000000000000
